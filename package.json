{
  "name": "postalkit",
  "version": "0.1.0",
  "description": "Validate, format and guess postal codes for 252 countries. Forgiving input, one canonical output, a reason for every rejection. Zero dependencies, under 4 kB gzipped.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/postalkit.git"
  },
  "homepage": "https://github.com/OWNER/postalkit#readme",
  "bugs": {
    "url": "https://github.com/OWNER/postalkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./regions": {
      "import": {
        "types": "./dist/regions.d.ts",
        "default": "./dist/regions.js"
      },
      "require": {
        "types": "./dist/regions.d.cts",
        "default": "./dist/regions.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "regions": [
        "./dist/regions.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=14"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    }
  },
  "scripts": {
    "fetch": "node scripts/fetch.ts",
    "data": "node scripts/build-data.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "corpus": "node scripts/fetch-corpus.ts",
    "size": "node scripts/size.ts --compare",
    "compare": "node scripts/compare.ts",
    "bench": "node scripts/bench.ts",
    "check": "npm run data && npm run typecheck && npm run build && npm test && npm run size && npm run lint:pkg",
    "prepublishOnly": "npm run check",
    "lint:pkg": "publint && attw --pack ."
  },
  "keywords": [
    "postal-code",
    "postcode",
    "zip-code",
    "zip",
    "validation",
    "format",
    "address",
    "checkout",
    "iso-3166",
    "zero-dependencies"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "postal-code-checker": "^2.3.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  }
}
